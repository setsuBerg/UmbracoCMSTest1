@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.HomePage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "MainLayout.cshtml";
}

<section class="relative py-[7rem]">
	<div class="absolute inset-0">
		@if (Model.HeroBgimage != null)
		{
            <img src="@Model.HeroBgimage.Url()" class=" w-full h-full object-cover" alt=""
				 style="width: 100%; max-height: 400px; object-fit: cover;" />
		}
	</div>

	<div class="container mx-auto px-4 relative z-10">
		<div class="w-5/12 flex-col gap-8">
			<h1 class="text-4xl font-bold leading-none">@Model.HeroTitle</h1>

			<div class="rte">@Model.HeroText</div>

			@if (Model.HeroLink != null)
			{
				<a class="bg-[#4F5955] text-white py-3 px-10 no-underline rounded cursor-pointer self-start font-bold" href="@Model.HeroLink.Url">@Model.HeroLink.Name</a>
			}
		</div>

	</div>
</section>






